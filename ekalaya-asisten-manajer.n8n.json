      "id": "norm",
      "name": "Normalisasi",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        660,
        -60
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-5-5', max_tokens: 700, system: \"Anda adalah asisten manajer penjualan untuk Ekalaya Virtual Office, showroom 3D online. Analisis data pengunjung/lead yang diberikan. Balas HANYA dengan JSON valid tanpa teks lain, dengan kunci: kategori (lead_panas | lead_hangat | lead_dingin | pertanyaan | keluhan | spam), skor (angka 0-100 tingkat kesiapan membeli), prioritas (tinggi | sedang | rendah), ringkasan (maks 25 kata, bahasa Indonesia), saran_tindakan (satu langkah konkret untuk tim), balasan_draft (pesan WhatsApp singkat, sopan, bahasa Indonesia).\", messages: [{ role: 'user', content: JSON.stringify($json) }] }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "ai-analisis-lead",
      "name": "AI Analisis Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -60
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "GANTI",
          "name": "Anthropic API Key (header x-api-key)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $input.first().json.content?.[0]?.text || '{}';\nlet ai;\ntry {\n  ai = JSON.parse(raw.replace(/```json|```/g, '').trim());\n} catch (e) {\n  ai = { kategori: 'tidak_diketahui', skor: 0, prioritas: 'sedang', ringkasan: raw.slice(0, 200), saran_tindakan: 'Tinjau manual', balasan_draft: '' };\n}\nconst data = $('Normalisasi').first().json;\nreturn [{ json: { ...data, ...ai, diproses_pada: new Date().toISOString() } }];"
      },
      "id": "parse",
      "name": "Olah Hasil AI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -60
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "GANTI_ID_GOOGLE_SHEET"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Leads"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
