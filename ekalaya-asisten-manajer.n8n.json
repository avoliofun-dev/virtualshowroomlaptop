      "id": "sheet-baca",
      "name": "Baca Data Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        420
      ],
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GANTI",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r.diproses_pada);\nconst batas = Date.now() - 24 * 60 * 60 * 1000;\nconst baru = rows.filter(r => new Date(r.diproses_pada).getTime() >= batas);\nconst skor = baru.map(r => Number(r.skor) || 0);\nconst rata = skor.length ? Math.round(skor.reduce((a, b) => a + b, 0) / skor.length) : 0;\nconst top = [...baru].sort((a, b) => (Number(b.skor) || 0) - (Number(a.skor) || 0)).slice(0, 5)\n  .map(r => ({ nama: r.nama, kontak: r.kontak, produk: r.produk, skor: r.skor, saran: r.saran_tindakan }));\nreturn [{ json: {\n  total_24_jam: baru.length,\n  prioritas_tinggi: baru.filter(r => r.prioritas === 'tinggi').length,\n  keluhan: baru.filter(r => r.kategori === 'keluhan').length,\n  rata_rata_skor: rata,\n  lead_teratas: top\n} }];"
      },
