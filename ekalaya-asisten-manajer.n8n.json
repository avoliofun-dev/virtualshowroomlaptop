        "chatId": "GANTI_CHAT_ID_MANAGER",
        "text": "={{ ($json.prioritas === 'tinggi' ? '🔥 PRIORITAS TINGGI' : '📩 Lead baru') + '\\n\\nNama: ' + $json.nama + '\\nKontak: ' + $json.kontak + '\\nProduk: ' + $json.produk + '\\nKategori: ' + $json.kategori + ' (skor ' + $json.skor + ')\\n\\nRingkasan: ' + $json.ringkasan + '\\nSaran: ' + $json.saran_tindakan + '\\n\\nDraft balasan:\\n' + $json.balasan_draft }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
