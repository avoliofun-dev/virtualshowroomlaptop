    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// ATUR BATAS DELEGASI DI SINI (rupiah, dan persen untuk diskon)\nconst BATAS_PENGELUARAN = 500000;\nconst BATAS_REFUND = 200000;\nconst BATAS_DISKON_PERSEN = 10;\n\nconst r = $input.first().json;\nlet otomatis = false;\nif (r.jenis === 'pengeluaran') otomatis = r.jumlah > 0 && r.jumlah <= BATAS_PENGELUARAN;\nelse if (r.jenis === 'refund') otomatis = r.jumlah > 0 && r.jumlah <= BATAS_REFUND;\nelse if (r.jenis === 'diskon') otomatis = r.diskon_persen > 0 && r.diskon_persen <= BATAS_DISKON_PERSEN;\n\nreturn [{ json: { ...r, otomatis } }];"
      },
