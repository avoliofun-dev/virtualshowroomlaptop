    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $input.first().json.content?.[0]?.text || '{}';\nlet ai;\ntry {\n  ai = JSON.parse(raw.replace(/```json|```/g, '').trim());\n} catch (e) {\n  ai = { rekomendasi: 'perlu_info', risiko: 'sedang', alasan: 'Analisis AI gagal dibaca, tinjau manual.', pertanyaan_lanjutan: '' };\n}\nconst r = $('Aturan Delegasi').first().json;\nconst rp = n => 'Rp ' + Number(n).toLocaleString('id-ID');\nconst detail = r.jenis === 'diskon' ? `Diskon: ${r.diskon_persen}%` : `Jumlah: ${rp(r.jumlah)}`;\nconst pesan = [\n  '🔔 PERSETUJUAN DIBUTUHKAN',\n  '',\n  `ID: ${r.id}`,\n  `Jenis: ${r.jenis}`,\n  `Pemohon: ${r.pemohon}`,\n  detail,\n  `Alasan pemohon: ${r.alasan || '-'}`,\n  '',\n  `Saran AI: ${String(ai.rekomendasi).toUpperCase()} (risiko ${ai.risiko})`,\n  `Catatan: ${ai.alasan}`,\n  ai.pertanyaan_lanjutan ? `Perlu ditanyakan: ${ai.pertanyaan_lanjutan}` : ''\n].filter(x => x !== null).join('\\n');\nreturn [{ json: { ...r, ...ai, pesan_ceo: pesan } }];"
      },
