    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const leads = $('Baca Leads').all().map(i => i.json).filter(r => r.diproses_pada);\nconst pesanan = $('Baca Pesanan').all().map(i => i.json).filter(r => r.tanggal);\n\nconst hariIni = new Date();\nconst hari = hariIni.getDay(); // 1 = Senin\nconst periode = hari === 1 ? 7 : 1; // Senin: rekap mingguan\nconst MS = 24 * 60 * 60 * 1000;\nconst t1 = Date.now() - periode * MS;\nconst t0 = Date.now() - 2 * periode * MS;\n\nconst inRange = (v, a, b) => { const t = new Date(v).getTime(); return t >= a && t < b; };\nconst angka = v => Number(String(v).replace(/[^0-9.-]/g, '')) || 0;\nconst lunas = r => ['lunas', 'paid', 'selesai', 'dikirim'].includes(String(r.status || '').toLowerCase());\n\nconst pNow = pesanan.filter(r => inRange(r.tanggal, t1, Infinity));\nconst pPrev = pesanan.filter(r => inRange(r.tanggal, t0, t1));\nconst lNow = leads.filter(r => inRange(r.diproses_pada, t1, Infinity));\nconst lPrev = leads.filter(r => inRange(r.diproses_pada, t0, t1));\n\nconst omzet = a => a.filter(lunas).reduce((s, r) => s + angka(r.total), 0);\nconst persen = (a, b) => b === 0 ? (a === 0 ? 0 : 100) : Math.round(((a - b) / b) * 100);\nconst rata = a => a.length ? Math.round(a.reduce((s, r) => s + angka(r.skor), 0) / a.length) : 0;\n\nconst konversi = lNow.length ? Math.round((pNow.filter(lunas).length / lNow.length) * 100) : 0;\n\nreturn [{ json: {\n  periode_hari: periode,\n  omzet: omzet(pNow), omzet_sebelumnya: omzet(pPrev), omzet_perubahan_persen: persen(omzet(pNow), omzet(pPrev)),\n  pesanan: pNow.length, pesanan_sebelumnya: pPrev.length,\n  pesanan_belum_bayar: pNow.filter(r => !lunas(r)).length,\n  lead: lNow.length, lead_sebelumnya: lPrev.length, lead_perubahan_persen: persen(lNow.length, lPrev.length),\n  lead_prioritas_tinggi: lNow.filter(r => r.prioritas === 'tinggi').length,\n  keluhan: lNow.filter(r => r.kategori === 'keluhan').length,\n  rata_rata_skor_lead: rata(lNow),\n  konversi_lead_ke_pesanan_persen: konversi,\n  lead_teratas: [...lNow].sort((a, b) => angka(b.skor) - angka(a.skor)).slice(0, 3)\n    .map(r => ({ nama: r.nama, produk: r.produk, skor: r.skor, saran: r.saran_tindakan }))\n} }];"
      },
